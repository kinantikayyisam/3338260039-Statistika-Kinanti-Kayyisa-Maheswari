        "def cek_ganjil_genap(angka):\n",
        "    # Operator % digunakan untuk mencari sisa hasil bagi\n",
        "    if angka % 2 == 0:\n",
        "        return \"genap\"\n",
        "    else:\n",
        "        return \"ganjil\""
